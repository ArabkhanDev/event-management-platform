# Base URL of the backend API, including the /api prefix.
# The WebSocket endpoint is derived from this by stripping /api and appending /ws.
#
# Local:      http://localhost:8080/api
# Production: https://auda-api.onrender.com/api  (set in the Vercel dashboard,
#             since Vite inlines VITE_* variables at build time)
VITE_API_BASE=http://localhost:8080/api
